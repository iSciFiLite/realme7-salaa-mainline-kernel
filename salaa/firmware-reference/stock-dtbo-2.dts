	fragment@44 {
		target = <0xffffffff>;

		__overlay__ {

			eint0default {
				phandle = <0x34>;
			};

			charger_gpio_as_output_low {
				phandle = <0x35>;

				pins_cmd_dat {
					pinmux = <0xc300>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			charger_gpio_as_output_high {
				phandle = <0x36>;

				pins_cmd_dat {
					pinmux = <0xc300>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			ship_sleep {
				phandle = <0x37>;

				pins_cmd_dat {
					pinmux = <0xb00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			ship_active {
				phandle = <0x38>;

				pins_cmd_dat {
					pinmux = <0xb00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			dischg_enable {
				phandle = <0x39>;

				pins_cmd_dat {
					pinmux = <0xd00>;
					slew-rate = <0x01>;
					bias-pull-up = <0x00>;
					output-high;
				};
			};

			dischg_disable {
				phandle = <0x3a>;

				pins_cmd_dat {
					pinmux = <0xd00>;
					slew-rate = <0x01>;
					bias-pull-down = <0x00>;
					output-low;
				};
			};
		};
	};

